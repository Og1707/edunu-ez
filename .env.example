# ============================================================
# Variables de entorno — EduNúñez
# Copia este archivo como .env y rellena los valores.
# NUNCA incluyas .env en control de versiones.
# ============================================================

# ---------------------------------------------------------------------------
# Django — Configuración general
# ---------------------------------------------------------------------------
# Módulo de settings activo. Opciones:
#   edunuñez.settings.development   ← desarrollo local (default)
#   edunuñez.settings.production    ← producción
DJANGO_SETTINGS_MODULE=edunuñez.settings.development

# Clave secreta de Django. OBLIGATORIA en producción.
# Genera con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Ambiente activo (development | staging | production)
DJANGO_ENV=development

# Hosts permitidos separados por coma (producción)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Nivel de log (DEBUG | INFO | WARNING | ERROR)
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Opción 1: URL completa (recomendada para producción y Docker)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edununez

# Opción 2: Variables individuales (alternativa)
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=edununez
# DJANGO_DB_USER=postgres
# DJANGO_DB_PASSWORD=postgres
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432

# Usar PostgreSQL real en tests (true | false)
USE_POSTGRES_TESTS=false

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
DJANGO_REDIS_URL=redis://127.0.0.1:6379/1

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Correo electrónico
# ---------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@edununez.local
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False

# URL base del frontend para generar magic links
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cloudinary (almacenamiento multimedia)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MAX_FILE_SIZE=104857600

# ---------------------------------------------------------------------------
# n8n Webhooks
# ---------------------------------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/Alumnos_settings
N8N_WEBHOOK_ENABLED=True
N8N_WEBHOOK_TIMEOUT=10
N8N_WEBHOOK_RETRY_ATTEMPTS=3

# Secret compartido con n8n para validar la firma HMAC de webhooks entrantes.
# OBLIGATORIO en producción.
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
N8N_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Sentry (monitoreo de errores en producción)
# ---------------------------------------------------------------------------
# Dejar vacío en desarrollo para deshabilitar Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
